# Copy to .env and fill in. .env is gitignored (it holds the real secrets).
# These override the defaults in config.php.

# League password for fetching games (required to see the game list).
WEGREP_LEAGUE_PASSWORD=

# Turn on real uploads to hockeydata (writes the official game report). Keep false until tested.
WEGREP_UPLOAD_ENABLED=false

# MySQL. With docker compose the host, name, user and password are preset and you can skip these.
# On the server set them to the values of your hosting (use a .env next to config.php if you cannot set
# environment variables).
# WEGREP_DB_HOST=localhost
# WEGREP_DB_PORT=3306
# WEGREP_DB_NAME=wegrep
# WEGREP_DB_USER=wegrep
# WEGREP_DB_PASSWORD=


# Login: people sign in with a code that is mailed to them, the app then gets a JWT.
# Secret used to sign those tokens and hash the codes, at least 32 random characters:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Changing it logs everybody out.
WEGREP_JWT_SECRET=

# The first administrator: this address is administrator from its first login (comma-separated list).
# After that administrators promote others inside the app.
WEGREP_ADMIN_EMAIL=

# Public address of the app, for the login link in the mails. Locally the Vite dev server;
# without it the mails only carry the code.
# WEGREP_APP_URL=http://localhost:5173

# Sender of the mails (use an address of your own domain on the server, or they land in spam).
# WEGREP_MAIL_FROM=wegrep@localhost
# WEGREP_MAIL_FROM_NAME=Wegrep

# Optional overrides (defaults live in config.php):
# WEGREP_DEBUG_HOCKEYDATA=false      # log every request to hockeydata and its answer, for debugging
# WEGREP_CUSTOMER=IJSijs
# WEGREP_API_BASE=https://los.hockeydata.net/los/data-asp/api
# WEGREP_EGREP_VERSION=e-grep_v26.1.0.2018
# WEGREP_LOGOS_ENABLED=true          # club logos from ijshockey.nl (no login)
# WEGREP_SEASON=2026-2027            # empty = derive from today's date
# WEGREP_CLUB_FILTER=true            # only show leagues/games of the clubs below
# WEGREP_CLUBS=Blue Mountain Cougars # comma-separated club names (substring match)
# WEGREP_DEMO_LEAGUE=false           # also show the demo league while filtering
# WEGREP_DEMO_LEAGUES=320            # demo league id(s), comma-separated
