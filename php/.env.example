# Copy to .env and fill in. .env is gitignored (it holds the real secrets).
# These override the defaults in config.php.

# League password for fetching games (required to see the game list).
WEGREP_LEAGUE_PASSWORD=

# Turn on real uploads to hockeydata (writes the official game report). Keep false until tested.
WEGREP_UPLOAD_ENABLED=false

# Shared password to open the web app. Leave empty only on a private machine.
WEGREP_APP_PASSWORD=

# Optional overrides (defaults live in config.php):
# WEGREP_CUSTOMER=IJSijs
# WEGREP_API_BASE=https://los.hockeydata.net/los/data-asp/api
# WEGREP_EGREP_VERSION=e-grep_v21.0.1.1957
# WEGREP_LOGOS_ENABLED=true          # club logos from ijshockey.nl (no login)
# WEGREP_SEASON=2026-2027            # empty = derive from today's date
